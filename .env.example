# Copy this file to .env and fill in your real keys.

# OpenRouter — get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase — from your project's Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key
SUPABASE_ANON_KEY=your-anon-public-key

# Google Calendar OAuth — from Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Local default is http://localhost:3000/auth/google/callback.
# On Render, set this to https://YOUR-APP.onrender.com/auth/google/callback
# GOOGLE_REDIRECT_URI=

# Optional: which email sees the founder "Stats" tab (usage across all users).
# Defaults to the project owner's email if not set.
# ADMIN_EMAIL=you@example.com

# Optional: change the port the server runs on
PORT=3000
